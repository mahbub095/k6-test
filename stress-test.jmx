<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Stress Test - stage-api.bhata.gov.bd">
      <stringProp name="TestPlan.comments">Stress Test: mirrors stress-test.js.
Stages: 1m→500 | 2m→2000 | 3m→5000 | 5m→8000 (peak) | 2m→0 (ramp-down). Total=13m.
GracefulRampDown: 30s. Thresholds: login_duration p95&lt;5s | error_rate&lt;10% | http p90&lt;5s / p95&lt;6s.</stringProp>
      <boolProp name="TestPlan.serialize_threadgroups">true</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="BASE_URL" elementType="Argument">
            <stringProp name="Argument.name">BASE_URL</stringProp>
            <stringProp name="Argument.value">stage-api.bhata.gov.bd</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="USERNAME" elementType="Argument">
            <stringProp name="Argument.name">USERNAME</stringProp>
            <stringProp name="Argument.value">ibcs-qa-super</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="PASSWORD" elementType="Argument">
            <stringProp name="Argument.name">PASSWORD</stringProp>
            <stringProp name="Argument.value">Password#4</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CAPTCHA_VALUE" elementType="Argument">
            <stringProp name="Argument.name">CAPTCHA_VALUE</stringProp>
            <stringProp name="Argument.value">31</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="CAPTCHA_TOKEN" elementType="Argument">
            <stringProp name="Argument.name">CAPTCHA_TOKEN</stringProp>
            <stringProp name="Argument.value">$2y$12$WnVi/8BNy4WjmgXtdPnGUeg4UrfSHPqWMxKvx88aOVD9can3HNO42</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="OTP" elementType="Argument">
            <stringProp name="Argument.name">OTP</stringProp>
            <stringProp name="Argument.value">375450</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="P95_LOGIN_THRESHOLD_MS" elementType="Argument">
            <stringProp name="Argument.name">P95_LOGIN_THRESHOLD_MS</stringProp>
            <stringProp name="Argument.value">5000</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="P90_HTTP_THRESHOLD_MS" elementType="Argument">
            <stringProp name="Argument.name">P90_HTTP_THRESHOLD_MS</stringProp>
            <stringProp name="Argument.value">5000</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults">
        <intProp name="HTTPSampler.connect_timeout">30000</intProp>
        <intProp name="HTTPSampler.response_timeout">30000</intProp>
        <stringProp name="HTTPSampler.domain">${BASE_URL}</stringProp>
